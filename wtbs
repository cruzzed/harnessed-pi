#!/usr/bin/env bash
# wtbs — worktree-bootstrap: branch↔directory 1:1 worktrees + pi-less-yolo agents.
#
# Usage (run from the parent project root):
#   wtbs <branch>                      bootstrap: create worktree (refuses if the
#                                      branch already has a directory — 1:1 doctrine)
#   wtbs <branch> spawn-ply [id]       spawn an interactive pi agent (detached)
#   wtbs <branch> spawn-ply [id] -p "prompt"   spawn a headless pi agent
#   wtbs <branch> attach <id>          attach to an interactive agent (Ctrl-P Ctrl-Q to leave)
#   wtbs <branch> list-ply             agents + write-lock + vicinity state
#   wtbs <branch> stop-ply [id]        stop one agent, or all for this worktree
#   wtbs <branch> destroy              stop agents, remove worktree (branch kept)
#
# Instance ids default to a random suffix; the same id names the container
# (ply-<project>-<branch>-<id>) and the safety-gate's write-lock owner.

set -euo pipefail

DOCKER_FLAGS_FILE="$HOME/pi-less-yolo/tasks/pi/_docker_flags"

die() { echo "wtbs: $*" >&2; exit 1; }

[[ $# -ge 1 ]] || die "usage: wtbs <branch> [command] (see script header)"
BRANCH="$1"; shift || true
CMD="${1:-bootstrap}"; [[ $# -ge 1 ]] && shift || true

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repo"
PROJECT="$(basename "$PROJECT_ROOT")"
WT="$(realpath -m "$PROJECT_ROOT/../${PROJECT}-$(echo "$BRANCH" | tr '/' '-')")"

# re-exec under the docker group when needed (pre-re-login shells)
if ! docker info >/dev/null 2>&1; then
  exec sg docker -c "$(printf '%q ' "$0" "$BRANCH" "$CMD" "$@")"
fi

wt_exists() { git -C "$PROJECT_ROOT" worktree list --porcelain | grep -q "^worktree $WT$"; }
branch_has_dir() { git -C "$PROJECT_ROOT" worktree list --porcelain | grep -A10 "^worktree " | grep -q "refs/heads/$BRANCH$"; }

case "$CMD" in
  bootstrap)
    branch_has_dir && die "branch '$BRANCH' already has a directory (1:1 doctrine). Use it, or pick a new branch."
    [[ -e "$WT" ]] && die "path exists: $WT"
    if git -C "$PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
      git -C "$PROJECT_ROOT" worktree add "$WT" "$BRANCH"
    else
      git -C "$PROJECT_ROOT" worktree add -b "$BRANCH" "$WT"
    fi
    echo "worktree ready: $WT (branch $BRANCH)"
    ;;

  spawn-ply)
    wt_exists || die "no worktree at $WT — run: wtbs $BRANCH"
    ID="${1:-}"; [[ "$ID" == -* || -z "$ID" ]] || shift
    [[ -n "$ID" ]] || ID="$(head -c4 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    NAME="ply-${PROJECT}-$(echo "$BRANCH" | tr '/' '-')-${ID}"
    PROMPT=""
    if [[ "${1:-}" == "-p" ]]; then PROMPT="${2:?-p needs a prompt}"; fi

    [[ -f ~/.config/pi-agent/env ]] || die "missing ~/.config/pi-agent/env (provider key)"
    source ~/.config/pi-agent/env  # provider keys, forwarded by _docker_flags
    cd "$WT"
    # Identity must be set before sourcing: _docker_flags turns these into
    # --env/--label/--name flags.
    export PI_INSTANCE_ID="$ID"
    export PI_LABELS="ply.project=$PROJECT,ply.worktree=$BRANCH"
    export PI_CONTAINER_NAME="$NAME"
    # shellcheck disable=SC1090
    source "$DOCKER_FLAGS_FILE"

    DOCKER_FLAGS+=("--detach")

    if [[ -n "$PROMPT" ]]; then
      # Headless: no tty, no held-open stdin (pi -p blocks on stdin EOF otherwise)
      "${DOCKER_CMD}" run "${DOCKER_FLAGS[@]}" "${PI_IMAGE}" -p "$PROMPT" </dev/null >/dev/null
      echo "headless agent $NAME started (id: $ID) — logs: docker logs -f $NAME"
    else
      DOCKER_FLAGS+=("--interactive")
      [ -t 0 ] && [ -t 1 ] && DOCKER_FLAGS+=("--tty")
      "${DOCKER_CMD}" run "${DOCKER_FLAGS[@]}" "${PI_IMAGE}" >/dev/null
      echo "interactive agent $NAME started (id: $ID) — attach: wtbs $BRANCH attach $ID"
    fi
    ;;

  attach)
    ID="${1:?attach needs an instance id}"
    docker attach "ply-${PROJECT}-$(echo "$BRANCH" | tr '/' '-')-${ID}"
    ;;

  list-ply)
    LABEL="ply.worktree=$BRANCH"
    echo "containers:"
    docker ps --filter "label=ply.project=$PROJECT" --filter "label=$LABEL" \
      --format "  {{.Names}}  {{.Status}}"
    echo "write-lock:"
    if [[ -f "$WT/.pi-writelock/owner" ]]; then
      echo "  held by: $(cat "$WT/.pi-writelock/owner")  ($(stat -c '%y' "$WT/.pi-writelock" | cut -d. -f1))"
    else
      echo "  free"
    fi
    echo "vicinity (fresh < 2 min):"
    now=$(date +%s)
    if [[ -d "$WT/.pi-agents" ]]; then
      for f in "$WT/.pi-agents"/*; do
        [[ -e "$f" ]] || continue
        age=$(( now - $(stat -c %Y "$f") ))
        [[ $age -lt 120 ]] && echo "  $(basename "$f") (active ${age}s ago)" || echo "  $(basename "$f") (stale)"
      done
    else
      echo "  none"
    fi
    ;;

  stop-ply)
    ID="${1:-}"
    if [[ -n "$ID" ]]; then
      docker stop "ply-${PROJECT}-$(echo "$BRANCH" | tr '/' '-')-${ID}"
    else
      mapfile -t cs < <(docker ps -q --filter "label=ply.project=$PROJECT" --filter "label=ply.worktree=$BRANCH")
      [[ ${#cs[@]} -gt 0 ]] && docker stop "${cs[@]}" || echo "no agents running for $BRANCH"
    fi
    ;;

  destroy)
    WTBS_SELF="$(realpath "$0")"
    "$WTBS_SELF" "$BRANCH" stop-ply || true
    git -C "$PROJECT_ROOT" worktree remove --force "$WT"
    echo "worktree removed (branch $BRANCH kept — delete with: git branch -D $BRANCH)"
    ;;

  *)
    die "unknown command: $CMD"
    ;;
esac
