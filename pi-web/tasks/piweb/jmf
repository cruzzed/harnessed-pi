#!/usr/bin/env bash
#MISE description="Run jmfederico/pi-web (battleship UI) in the pi-less-yolo-web container"
#MISE raw=true
#MISE dir="{{cwd}}"
set -euo pipefail

# shellcheck source=/dev/null
source "${HOME}/pi-less-yolo/tasks/pi/_docker_flags"

PI_WEB_INSTANCE="${PI_WEB_INSTANCE:-main}"
PROJECT="$(basename "$(pwd)")"
HASH="$(printf '%s' "$(pwd):${PI_WEB_INSTANCE}" | cksum | cut -d' ' -f1)"
export PI_INSTANCE_ID="web-${PI_WEB_INSTANCE}"
WORKTREE_NAME="$(git branch --show-current 2>/dev/null || true)"
WORKTREE_NAME="${WORKTREE_NAME:-$(basename "$(pwd)")}"
PI_LABELS="ply.project=${PROJECT},ply.worktree=${WORKTREE_NAME},ply.instance=${PI_WEB_INSTANCE}"
export PI_LABELS
export PI_CONTAINER_NAME="ply-web-${PROJECT}-${PI_WEB_INSTANCE}"

PI_IMAGE="pi-less-yolo-web:latest"
"${DOCKER_CMD}" image inspect "${PI_IMAGE}" > /dev/null 2>&1 || mise run piweb:jmf-build

DOCKER_FLAGS+=("--interactive")
[ -t 0 ] && [ -t 1 ] && DOCKER_FLAGS+=("--tty")

PI_WEB_PORT="${PI_WEB_PORT:-$((8504 + HASH % 96))}"
DOCKER_FLAGS+=("--publish" "127.0.0.1:${PI_WEB_PORT}:8504")

DATA_DIR="${HOME}/.local/share/pi-web/$(printf '%s' "$(pwd)" | cksum | cut -d' ' -f1)/${PI_WEB_INSTANCE}"
mkdir -p "${HOME}/.config/pi-web" "${DATA_DIR}"
DOCKER_FLAGS+=(
  "--volume" "${HOME}/.config/pi-web:/home/piuser/.config/pi-web"
  "--volume" "${DATA_DIR}:/home/piuser/.local/share/pi-web"
  "--env" "PI_WEB_HOST=0.0.0.0"
  "--env" "PI_WEB_PORT=8504"
  "--env" "PI_WEB_DATA_DIR=/home/piuser/.local/share/pi-web"
)

echo "pi-web [${PI_WEB_INSTANCE}] UI: http://127.0.0.1:${PI_WEB_PORT} (Ctrl-C stops the container)" >&2

"${DOCKER_CMD}" run "${DOCKER_FLAGS[@]}" "${PI_IMAGE}" \
  bash -c 'pi-web-sessiond & exec pi-web-server'
