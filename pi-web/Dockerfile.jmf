# syntax=docker/dockerfile:1

# pi-less-yolo-web: pi-web UI layered on the pi-less-yolo image.
# The base image (Chainguard node -dev) already ships gcc/g++/make/python3,
# which node-pty needs — musl has no prebuilt binaries, so it compiles from source.
FROM pi-less-yolo:latest

USER root

# Install pi-web globally. Explicit --prefix=/usr/local: the base image's .npmrc
# sets prefix=/pi-agent/npm-global (pi's runtime extension dir, shadowed by the
# host mount at runtime), which would hide a build-time install.
RUN npm install -g --prefix=/usr/local @jmfederico/pi-web --allow-scripts=node-pty

USER node
